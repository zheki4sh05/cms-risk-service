# Скопируйте в .env и подставьте свои значения.
# PostgreSQL и Kafka запускаются отдельно — здесь только адреса подключения.
# На Windows/macOS для сервисов на хосте используйте host.docker.internal.

SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/cms_risk
DB_USERNAME=postgres
DB_PASSWORD=postgres

KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9000
KAFKA_CONSUMER_GROUP_ID=cms-risk-service
KAFKA_RISK_TOPIC=risk_topic
KAFKA_INCIDENT_TOPIC=incident_topic

AUTH_SERVICE_BASE_URL=http://host.docker.internal:9091
MONITORING_SERVICE_BASE_URL=http://host.docker.internal:9093
RISK_OBJECT_SERVICE_BASE_URL=http://host.docker.internal:9093

JWT_PUBLIC_KEY=
